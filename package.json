{
  "name": "mono-poly-on-chain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run compile:contract && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "compile:contract": "node scripts/compile-contract.mjs",
    "test": "tsx --test tests/game.test.ts",
    "test:contract": "node tests/contract.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "playwright": "1.58.2",
    "@axe-core/playwright": "4.11.1"
  },
  "overrides": {
    "rollup": "4.52.4"
  }
}
